# ─────────────────────────────────────────────────────────────────────────────
# Tallei backend — environment variables
#
# Convention: TALLEI_<GROUP>__<KEY>
# Parsed once at boot in src/config/load.ts → import { config } from "./config"
#
# Legacy names (OPENAI_API_KEY, DATABASE_URL, etc.) are auto-mapped at boot via
# src/config/env-aliases.ts with a one-time deprecation warning.
# See docs/adr/005-config-schema-zod.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
TALLEI_HTTP__PORT=3000
TALLEI_HTTP__HOST=127.0.0.1
TALLEI_HTTP__PUBLIC_BASE_URL=https://<ngrok-url>
TALLEI_HTTP__FRONTEND_URL=https://<ngrok-url>
TALLEI_HTTP__DASHBOARD_BASE_URL=https://<ngrok-url>
TALLEI_HTTP__MCP_URL=https://<ngrok-url>/mcp
TALLEI_HTTP__INTERNAL_API_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
TALLEI_DB__URL=postgresql://tallei:tallei@localhost:5432/tallei
TALLEI_DB__URL_FALLBACK=postgresql://tallei:tallei@localhost:5432/tallei
TALLEI_AUTH__SUPABASE_URL=https://<project-ref>.supabase.co
TALLEI_AUTH__SUPABASE_SERVICE_ROLE_KEY=
ENABLE_SUPABASE_RLS_POLICIES=true

# ── Auth / crypto ────────────────────────────────────────────────────────────
TALLEI_AUTH__JWT_SECRET=your_jwt_secret
TALLEI_AUTH__CONTINUATION_PRIVATE_KEY=
TALLEI_AUTH__CONTINUATION_PUBLIC_KEY=
TALLEI_AUTH__CONTINUATION_TTL_SECONDS=600
TALLEI_AUTH__MEMORY_MASTER_KEY=
TALLEI_AUTH__KMS_KEY_ID=tallei-memory-key-v1

# ── Storage ──────────────────────────────────────────────────────────────────
TALLEI_STORAGE__UPLOADTHING_TOKEN=

# ── LLM / Model Gateway ──────────────────────────────────────────────────────
# Provider + defaults (see src/model/registry.ts for purpose routing)
TALLEI_LLM__LOCAL_MODEL_MODE=true
TALLEI_LLM__PROVIDER=ollama
TALLEI_LLM__CHAT_MODEL=gpt-5-nano
TALLEI_LLM__OLLAMA_BASE_URL=http://localhost:11434/v1
TALLEI_LLM__OLLAMA_MODEL=qwen2.5:7b
TALLEI_LLM__OPENAI_API_KEY=sk-xxx

# Purpose-specific models (override defaults per gateway purpose)
TALLEI_LLM__INTENT_CLASSIFIER_MODEL=gpt-5-nano

# OpenCode Zen — https://opencode.ai/docs/zen/
# TALLEI_LLM__LOCAL_MODEL_MODE=false
# TALLEI_LLM__PROVIDER=opencode
# TALLEI_LLM__OPENCODE_API_KEY=
# TALLEI_LLM__OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# TALLEI_LLM__OPENCODE_MODEL=deepseek-v4-flash-free

# NVIDIA NIM — https://ai-sdk.dev/providers/openai-compatible-providers/nim
# TALLEI_LLM__LOCAL_MODEL_MODE=false
# TALLEI_LLM__PROVIDER=nvidia
# TALLEI_LLM__NVIDIA_API_KEY=           # or legacy NIM_API_KEY
# TALLEI_LLM__NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# TALLEI_LLM__NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ── Embeddings (can differ from chat provider) ───────────────────────────────
TALLEI_EMBED__PROVIDER=ollama
TALLEI_EMBED__MODEL=nomic-embed-text
TALLEI_EMBED__DIMS=768
TALLEI_EMBED__GOOGLE_MODEL=gemini-embedding-001

# ── Google / Vertex (optional) ───────────────────────────────────────────────
TALLEI_GOOGLE__PROJECT_ID=
TALLEI_GOOGLE__LOCATION=us-central1
TALLEI_GOOGLE__API_KEY=
TALLEI_LLM__GOOGLE_MODEL=gemini-2.0-flash
TALLEI_FEATURE__VERTEX_DOCUMENT_SEARCH=false

# ── Qdrant ───────────────────────────────────────────────────────────────────
TALLEI_QDRANT__URL=https://<cluster-id>.cloud.qdrant.io
TALLEI_QDRANT__API_KEY=
TALLEI_QDRANT__COLLECTION=memories_local_v1
# TALLEI_QDRANT__TIMEOUT_MS=10000

# ── Redis (optional — leave unset for fail-open no-cache mode) ───────────────
# TALLEI_REDIS__URL=redis://localhost:6379

# ── Feature flags ────────────────────────────────────────────────────────────
TALLEI_FEATURE__RERANK=true
TALLEI_FEATURE__USE_NEW_SAVE=false
TALLEI_FEATURE__USE_NEW_RECALL=false
TALLEI_FEATURE__USE_NEW_LIST=false
TALLEI_FEATURE__USE_NEW_DELETE=false
# TALLEI_FEATURE__MEMORY_DUAL_WRITE=false
# TALLEI_FEATURE__MEMORY_SHADOW_READ=false

# ── Google OAuth (MCP flow) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<ngrok-url>/api/auth/google/callback

# ── Dashboard pairing (see dashboard/.env.example) ───────────────────────────
# Dashboard INTERNAL_API_SECRET must match TALLEI_HTTP__INTERNAL_API_SECRET

# ── Legacy aliases (deprecated — use TALLEI_* names above) ─────────────────
# OPENAI_API_KEY              → TALLEI_LLM__OPENAI_API_KEY
# DATABASE_URL                → TALLEI_DB__URL
# JWT_SECRET                  → TALLEI_AUTH__JWT_SECRET
# REDIS_URL                   → TALLEI_REDIS__URL
# PORT                        → TALLEI_HTTP__PORT
# TALLEI_LOOP_BUILDER__OPENAI_MODEL → TALLEI_CONDUCTOR__MODEL
# NIM_API_KEY                   → TALLEI_LLM__NVIDIA_API_KEY
# QDRANT_TIMEOUT_SECONDS      → TALLEI_QDRANT__TIMEOUT_MS (seconds → ms at boot)
